generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

// === ENUM BARU UNTUK STATUS PESANAN ===
enum OrderStatus {
  PENDING     // Menunggu Pembayaran
  PAID        // Sudah Dibayar
  SHIPPED     // Sedang Dikirim
  COMPLETED   // Selesai
  CANCELED    // Dibatalkan
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  whatsapp      String?
  address       String?
  role          Role          @default(CUSTOMER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  password         String?
  twoFactorEnabled Boolean?  @default(false)
  twoFactorSecret  String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cartItems     CartItem[]
  messages      ChatMessage[]
}

// === TABEL HOME (GARIS BESAR EPISODE) ===
model Episode {
  id              String    @id @default(cuid())
  episodeNo       String    @unique // Contoh: "01"
  title           String    // Contoh: "OPUS ARCANUM"
  descriptionLeft String?   @db.Text 
  descriptionRight String?  @db.Text 
  heroImage       String?
  videoUrl        String?   
  isActive        Boolean   @default(true) 

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  articles        Product[] 
}

model Product {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String     @db.Text
  price          Float      // DIUBAH KE FLOAT UNTUK HARGA USD ($)
  stock          Int        @default(0)
  images         String[]
  sizes          String[]   @default([])

  episodeId      String?
  episode        Episode?   @relation(fields: [episodeId], references: [id])

  // --- FITUR STORY PAGE ---
  isArticle           Boolean  @default(false)
  articleNo           String?  
  articleTitle        String?  
  articleSubtitle     String?  
  heroImage           String?  
  storyLeft           String?  @db.Text 
  storyIntro          String?
  storyRight          String?  @db.Text 
  galleryImages       String[] 
  
  editorialCaption    String?  
  editorialBody       String?  @db.Text 
  editorialBodyRight  String?  @db.Text 
  editorialImage      String?  
  editorialImageRight String?  
  
  videoThumb          String?  
  videoUrl            String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  size      String?  // Tambahan untuk menyimpan detail ukuran di database
  color     String?  // Tambahan untuk menyimpan detail warna di database
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// === TABEL ORDER (DIPERBARUI) ===
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // MTR-YYYYMMDD-XXX
  
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipientName   String
  email           String
  phone           String
  address         String      @db.Text
  
  totalAmount     Float       // USD
  
  status          OrderStatus @default(PENDING)
  courier         String?     // Contoh: JNE, J&T, dll
  trackingNumber  String?     // Nomor Resi
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

// === TABEL ORDER ITEM (DIPERBARUI) ===
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  
  name      String   // Menyimpan nama produk saat itu dibeli
  size      String   // Ukuran yang dipilih
  color     String   // Warna yang dipilih
  price     Float    // Harga saat dibeli dalam USD
  quantity  Int

  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String?  // atau phone, sesuaikan dengan aslinya
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}